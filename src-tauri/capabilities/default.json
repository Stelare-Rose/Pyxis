{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": [
		"main"
  ],
  "permissions": [
	  "core:default",
	  "fs:default",
	  {
		  "identifier": "fs:scope",
		  "allow": [
			  {
				  "path": "$DATA/**"
			  },
			  {
				  "path": "$CACHE/**"
			  },
			  {
				  "path": "$CONFIG/**"
			  }
		  ]
	  },
	  {
		  "identifier": "fs:allow-watch",
		  "allow": [
			  {
				  "path": "$CONFIG/**"
			  }
		  ]
	  },
	  {
		  "identifier": "fs:allow-write-text-file",
		  "allow": [
			  {
				  "path": "$DATA/**"
			  }
		  ]
	  },
	  {
		  "identifier": "fs:allow-remove",
		  "allow": [
			  {
				  "path": "$DATA/**"
			  }
		  ]
	  },
	  "log:default",
	  "sql:default",
	  "sql:allow-execute"
  ]
}
